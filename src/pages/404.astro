---
import Base from "../layouts/Base.astro";
import Seccion from "../components/Seccion.astro";
import { nav } from "../data/site";
---

<Base
  titulo="Página no encontrada"
  descripcion="La página que buscas no existe o cambió de dirección. Estas son las secciones del sitio."
>
  <Seccion titulo="Esta página no existe" etiqueta="Error 404" como="h1">
    <p class="texto measure">
      El enlace está roto o la página cambió de dirección. Estas sí funcionan:
    </p>
    <ul class="opciones">
      {
        nav.map((item) => (
          <li>
            <a class="link" href={item.href}>
              {item.texto}
            </a>
          </li>
        ))
      }
    </ul>
  </Seccion>
</Base>

<style>
  .texto {
    font-size: var(--step-1);
    color: var(--fg-muted);
    margin-bottom: var(--space-8);
  }

  .opciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  .opciones a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
</style>
