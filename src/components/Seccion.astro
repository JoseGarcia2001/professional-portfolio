---
/* Envoltura de sección: ritmo vertical y encabezado consistentes en todas las páginas. */
interface Props {
  titulo?: string;
  etiqueta?: string;
  id?: string;
  class?: string;
  /** Nivel del título. La sección principal de cada página usa "h1": sin él
   * la página no declara su tema y la jerarquía de encabezados queda rota. */
  como?: "h1" | "h2";
}

const { titulo, etiqueta, id, class: className, como = "h2" } = Astro.props;
const Titulo = como;
---

<section class:list={["seccion", className]} id={id}>
  <div class="container">
    {
      (etiqueta || titulo) && (
        <header class="seccion__head">
          {etiqueta && <p class="eyebrow">{etiqueta}</p>}
          {titulo && <Titulo class="seccion__titulo">{titulo}</Titulo>}
        </header>
      )
    }
    <slot />
  </div>
</section>

<style>
  .seccion {
    padding-block: var(--space-12);
  }

  .seccion__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  /* El tamaño lo fija la clase: un h1 de sección no debe crecer al tamaño
   * del titular de la portada. */
  .seccion__titulo {
    font-size: var(--step-2);
  }

  @media (min-width: 48rem) {
    .seccion {
      padding-block: var(--space-16);
    }

    .seccion__head {
      margin-bottom: var(--space-12);
    }
  }
</style>
