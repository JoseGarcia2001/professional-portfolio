---
import { contacto, legal, site } from "../data/site";

const anio = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__bloque">
      <p class="footer__nombre">{site.nombre}</p>
      <p class="footer__rol">{site.rol}</p>
    </div>

    <nav class="footer__bloque" aria-label="Contacto y enlaces legales">
      <ul class="footer__lista">
        <li>
          <a class="link" href={contacto.linkedin} rel="me noopener" target="_blank"
            >LinkedIn</a
          >
        </li>
        <li>
          <a class="link" href={contacto.github} rel="me noopener" target="_blank">GitHub</a>
        </li>
        {
          legal.map((item) => (
            <li>
              <a class="link" href={item.href}>
                {item.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container">
    <p class="footer__copy">© {anio} {site.nombre}. Sitio construido con Astro.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-24);
    padding-block: var(--space-12) var(--space-8);
    border-top: 1px solid var(--border);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .footer__nombre {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  .footer__rol {
    font-size: var(--step--1);
    color: var(--fg-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-top: var(--space-2);
  }

  .footer__lista {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  .footer__lista a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: var(--step--1);
  }

  .footer__copy {
    margin-top: var(--space-12);
    font-size: var(--step--1);
    color: var(--fg-subtle);
  }

  @media (min-width: 48rem) {
    .footer__inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }
</style>
