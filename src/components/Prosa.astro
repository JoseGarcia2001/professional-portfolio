---
/* Contenedor de texto largo. Solo las páginas legales lo usan: fija la medida
 * de lectura y da estilo a los elementos que vienen del markup, sin clases. */
---

<div class="prosa measure">
  <slot />
</div>

<style>
  .prosa :global(h2) {
    font-size: var(--step-1);
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
  }

  .prosa :global(h2:first-child) {
    margin-top: 0;
  }

  .prosa :global(p),
  .prosa :global(ul) {
    margin-bottom: var(--space-4);
    color: var(--fg-muted);
  }

  .prosa :global(ul) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-left: var(--space-6);
    list-style: disc;
  }

  .prosa :global(strong) {
    color: var(--fg);
    font-weight: 400;
  }

  .prosa :global(a) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color var(--transition), text-decoration-color var(--transition);
  }

  .prosa :global(a:hover) {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .prosa :global(.actualizado) {
    font-size: var(--step--1);
    color: var(--fg-subtle);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-8);
  }
</style>
