{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jogadev-site",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-31",
  // Cloudflare recomienda Workers para proyectos nuevos, tambien los estaticos:
  // Pages sigue soportado, pero toda la inversion futura va a Workers.
  // https://developers.cloudflare.com/workers/static-assets/migration-guides/migrate-from-pages/
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // El Worker ve TODAS las peticiones, tambien las que tienen asset: si no,
    // los redirects de protocolo y de www no se aplicarian a las paginas.
    "run_worker_first": true,
    // Astro genera un .html por ruta (build.format: "file"), asi que
    // /trayectoria se sirve desde trayectoria.html sin redireccion.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
